<div class="boxEmpresaInformacaoLayout">
  <h1 class="titulo" data-field="empresa-sessao-credenciais.titulo">{{titulo}}</h1>
</div>

<div class="boxTodasEmpresasLayout">
  <div class="wrap">
    <div class="slider-card">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">

          <!-- Slide 1 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-1}}">
              <img src="https://images.unsplash.com/photo-1518779578993-ec3579fee39f?auto=format&fit=crop&w=600&q=60"
                   alt="{{nome-empresa-1}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.nome-empresa-1">{{nome-empresa-1}}</h3>
                <p data-field="empresa-sessao-credenciais.sobre-empresa-1">{{sobre-empresa-1}}</p>
              </div>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-2}}">
              <img src="/src/images/pages/empresa/pages-empresa-credenciadas/empresa-viagem.png"
                   alt="{{nome-empresa-2}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.nome-empresa-2">{{nome-empresa-2}}</h3>
                <p data-field="empresa-sessao-.sobre-empresa-2">{{sobre-empresa-2}}</p>
              </div>
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-3}}">
              <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=600&q=60"
                   alt="{{nome-empresa-3}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.nome-empresa-3">{{nome-empresa-3}}</h3>
                <p data-field="empresa-sessao-credenciais.sobre-empresa-3">{{sobre-empresa-3}}</p>
              </div>
            </div>
          </div>

          <!-- Slide 4 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-4}}">
              <img src="https://www.silicon.pt/wp-content/uploads/2013/11/imagens-imagens-de-empresas-f63cd8.jpg"
                   alt="{{nome-empresa-4}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.nome-empresa-4">{{nome-empresa-4}}</h3>
                <p data-field="empresa-sessao-credenciais.sobre-empresa-4">{{sobre-empresa-4}}</p>
              </div>
            </div>
          </div>

          <!-- Slide 5 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-5}}">
              <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=600&q=60"
                   alt="{{nome-empresa-5}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.nome-empresa-5">{{nome-empresa-5}}</h3>
                <p data-field="empresa-sessao-credenciais.sobre-empresa-5">{{sobre-empresa-5}}</p>
              </div>
            </div>
          </div>

          <!-- Slide 6 -->
          <div class="swiper-slide">
            <div class="brand-thumb" tabindex="0" aria-label="{{nome-empresa-6}}">
              <img src="https://images.unsplash.com/photo-1485217988980-11786ced9454?auto=format&fit=crop&w=600&q=60"
                   alt="{{nome-empresa-6}}" />
              <div class="brand-info">
                <h3 data-field="empresa-sessao-credenciais.sobre-empresa-6">{{nome-empresa-6}}</h3>
                <p data-field="empresa-sessao-.sobre-empresa-6">{{sobre-empresa-6}}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="swiper-pagination" aria-hidden="true"></div>
        <div class="swiper-button-prev" aria-label="Anterior"></div>
        <div class="swiper-button-next" aria-label="Próximo"></div>
      </div>
    </div>
  </div>
</div>
<div class="boxPlacaSeloImagem">
  <img src="/src/images/pages/home/placa-selo.png" alt="Imagem da placa do selo bem receber">
</div>

<div class="boxPlacaSeloTexto">
  <h1 data-field="home-sessao-placa-selo.titulo">{{titulo}}</h1>
  <p data-field="home-sessao-placa-selo.paragrafo">{{paragrafo}}</p>
  <button type="button" class="btnEnviar"><span data-field="home-sessao-placa-selo.botao-participar">{{botao-participar}}</span></button>
</div>
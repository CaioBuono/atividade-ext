<div class="boxInformacoesLayout">
  <div class="boxInfoTitulo">
    <h1 data-field="home-sessao-informacoes.titulo">{{titulo}}</h1>
    <p data-field="home-sessao-informacoes.paragrafo-principal">{{paragrafo-principal}}</p>
  </div>

  <div class="boxInfoAdicional">
    <div class="boxInfoPadrao">
      <div class="boxInfoIcon">
        <i class="material-icons">emoji_events</i>
        <span data-field="home-sessao-informacoes.fist-span">{{fist-span}}</span>
      </div>
      <p data-field="home-sessao-informacoes.paragrafo-span-exp">{{paragrafo-span-exp}}</p>
    </div>

    <div class="boxInfoPadrao">
      <div class="boxInfoIcon">
        <i class="material-icons">school</i>
        <span data-field="home-sessao-informacoes.second-span">{{second-span}}</span>
      </div>
      <p data-field="home-sessao-informacoes.paragrafo-aula">{{paragrafo-aula}}</p>
    </div>

    <div class="boxInfoPadrao">
      <div class="boxInfoIcon">
        <i class="material-icons">card_membership</i>
        <span data-field="home-sessao-informacoes.third-span">{{third-span}}</span>
      </div>
      <p data-field="home-sessao-informacoes.paragrafo-certificado">{{paragrafo-certificado}}</p>
    </div>
  </div>

  <div class="boxBotaoInformacoes">
    <button type="button" class="btnEnviar"><span data-field="home-sessao-informacoes.botao-participar">{{botao-participar}}</span></button>
  </div>
</div>
<div class="boxFeedbacksLayout">
  <div class="boxTextoFeedbacks">
    <h1 data-field="home-sessao-feedbacks.titulo">{{titulo}}</h1>
  </div>

  <div class="boxFeedbacksGeral">
    <div class="boxFeedbackEmpresa">
      <i class="material-icons">format_quote</i>
      <p data-field="home-sessao-feedbacks.first-feedback">{{first-feedback}}</p>
      <p class="representanteEmpresa" data-field="home-sessao-feedbacks.first-representante">{{first-representante}}</p>
      <span data-field="home-sessao-feedbacks.first-span">{{first-span}}</span>
    </div>

    <div class="boxFeedbackEmpresa">
      <i class="material-icons">format_quote</i>
      <p data-field="home-sessao-feedbacks.second-feedback">{{second-feedback}}</p>
      <p class="representanteEmpresa" data-field="home-sessao-feedbacks.second-representante">{{second-representante}}</p>
      <span data-field="home-sessao-feedbacks.second-span">{{second-span}}</span>
    </div>

    <div class="boxFeedbackEmpresa">
      <i class="material-icons">format_quote</i>
      <p data-field="home-sessao-feedbacks.third-feedback">{{third-feedback}}</p>
      <p class="representanteEmpresa" data-field="home-sessao-feedbacks.third-representante">{{third-representante}}</p>
      <span data-field="home-sessao-feedbacks.third-span">{{third-span}}</span>
    </div>
  </div>
</div>